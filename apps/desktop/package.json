{
  "name": "desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:learn",
    "prebuild": "npm run build:learn",
    "build:learn": "node ../../scripts/build_learn.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test \"tests/*.test.ts\" && vitest run",
    "test:ui": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "setup": "PATH=\"$HOME/.cargo/bin:$PATH\" bash ../../scripts/ensure_dev.sh && PATH=\"$HOME/.cargo/bin:$PATH\" bash ../../scripts/ensure_sidecar_stub.sh",
    "free-port": "bash ../../scripts/free_vite_port.sh 5173",
    "sidecar": "PATH=\"$HOME/.cargo/bin:$PATH\" bash ../../scripts/build_sidecar.sh",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri",
    "tauri:dev": "npm run setup && npm run free-port && PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "tauri:build": "npm run sidecar && PATH=\"$HOME/.cargo/bin:$PATH\" tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "30.1.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "5.0.1"
  }
}
